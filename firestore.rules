rules_version = '2';
// Reglas de seguridad de Firestore para el sitio diocesano.
// Copie todo este texto en Firebase → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    // Contenido público: lo lee cualquiera, solo lo escriben administradores.
    match /publico/{doc} {
      allow read: if true;
      allow write: if esAdmin();
    }
    match /noticias/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // Cada persona puede comprobar si su propio correo es administrador.
    match /admins/{correo} {
      allow read: if request.auth != null && (request.auth.token.email.lower() == correo || esAdmin());
      allow write: if esAdmin();
    }

    // Todo lo demás (ajustes y colecciones de trabajo): solo administradores.
    match /{coleccion}/{id} {
      allow read, write: if esAdmin();
    }
  }
}
